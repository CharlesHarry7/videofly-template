# -----------------------------------------------------------------------------
# Required for Zombie Couple Video (Vercel + Neon + R2 + Stripe + KIE + Resend)
# Values are placeholders only. Do not put live secrets in the repo.
# -----------------------------------------------------------------------------

# PostgreSQL (Neon)
DATABASE_URL='postgresql://user:password@host:port/database?sslmode=require'
POSTGRES_URL='postgresql://user:password@host:port/database?sslmode=require'
# DATABASE_SSL_MODE=require

# App
NEXT_PUBLIC_APP_URL='http://localhost:3000'

# Auth (Better Auth + Resend magic link)
BETTER_AUTH_SECRET='replace_with_openssl_rand_base64_32'
RESEND_API_KEY='re_your_resend_api_key'
RESEND_FROM='noreply@yourdomain.com'

# Stripe one-time $6.99 checkout (test keys only in preview)
STRIPE_API_KEY='sk_test_your_stripe_api_key'
STRIPE_WEBHOOK_SECRET='whsec_your_webhook_secret'
NEXT_PUBLIC_BILLING_PROVIDER='stripe'

# Private R2 / S3 bucket
STORAGE_ENDPOINT='https://xxx.r2.cloudflarestorage.com'
STORAGE_REGION='auto'
STORAGE_ACCESS_KEY='your_r2_access_key_id'
STORAGE_SECRET_KEY='your_r2_secret_access_key'
STORAGE_BUCKET='your_private_bucket_name'
# Optional public domain is not used for paid videos.
# STORAGE_DOMAIN=

# KIE generation
KIE_API_KEY='your_kie_api_key'
DEFAULT_AI_PROVIDER='kie'
AI_CALLBACK_URL='https://your-domain.com/api/v1/video/callback'
CALLBACK_HMAC_SECRET='generate_random_secret_here'

# Free preview protection
BOT_CHECK_SECRET='generate_random_secret_here'
ZCV_MEDIA_TOKEN_SECRET='generate_random_secret_here'
ZCV_DAILY_PREVIEW_BUDGET='80'
ZCV_DAILY_PREVIEW_CREDIT_BUDGET='400'
ZCV_SUPPORT_EMAIL='support@yourdomain.com'
CRON_SECRET='generate_random_secret_here'

# Optional admin
ADMIN_EMAIL='your-email@example.com'
IS_DEBUG=false

